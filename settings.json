  "model": "sonnet",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/flutter-analyze.sh",
            "statusMessage": "Formatting, analyzing, testing Dart..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/prettier-format.sh",
            "statusMessage": "Running Prettier..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/eslint-check.sh",
            "statusMessage": "Running ESLint..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/henneth-group.py",
            "statusMessage": "Stamping Henneth group..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/destructive-warn.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "rtk hook claude" },
          {
            "type": "command",
            "command": "~/.claude/hooks/dir-guard.sh",
            "statusMessage": "Checking directory..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/protected-repo-guard.sh",
            "statusMessage": "Checking protected repos..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/pre-commit-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/worktree-guard.sh",
            "statusMessage": "Checking worktree..."
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/protected-repo-guard.sh",
            "statusMessage": "Checking protected repos..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/grammar-counter.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/grammar-reminder.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/handoff-poll.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-readme.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Before compacting, identify and preserve: 1) Current task and progress 2) Key decisions made 3) Files being modified and why 4) Any blockers or pending questions. Output this as additionalContext."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "figma@claude-plugins-official": true
  },
  "voiceEnabled": true
}
